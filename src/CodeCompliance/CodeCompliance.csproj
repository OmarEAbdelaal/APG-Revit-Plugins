<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Multi-version Revit add-in project.
    Pick a configuration to target a specific Revit version:
      Debug R24 / Release R24  -> Revit 2024 (.NET Framework 4.8)
      Debug R25 / Release R25  -> Revit 2025 (.NET 8)
      Debug R26 / Release R26  -> Revit 2026 (.NET 8)
      Debug R27 / Release R27  -> Revit 2027 (.NET 10)
  -->

  <PropertyGroup>
    <RootNamespace>CodeCompliance</RootNamespace>
    <AssemblyName>CodeCompliance</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Allows building net8.0-windows targets on non-Windows CI agents -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Configurations>Debug R24;Debug R25;Debug R26;Debug R27;Release R24;Release R25;Release R26;Release R27</Configurations>
    <Version>1.5.0</Version>
    <Company>APG</Company>
    <Authors>Omar Elsayed</Authors>
    <Product>APG Revit Plugins</Product>
    <Description>APG Revit Plugins suite: Code Compliance – Fire Fighting, DM BIM Compliance (Dubai Municipality e-submission), Ramp Creator (Dubai Building Code Annex B), Magic Annotation and Revit MCP (Claude connector). Author: Omar Elsayed.</Description>
    <Copyright>© APG — Omar Elsayed</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- APG brand icons for the ribbon and dialogs; regenerated by tools/gen-icons.ps1 -->
    <EmbeddedResource Include="Resources\**\*.png" />
    <!--
      Dubai Municipality BIM compliance knowledge base (DM's IDS rule set, the Appendix B
      element attribute matrices and the Appendix C usage codes). Shipped as data, never
      hardcoded: DM revises the standard every few months and the files can be replaced in
      Documents\CodeCompliance\DMKnowledgeBase without rebuilding the plugin.
    -->
    <EmbeddedResource Include="Resources\DmKnowledgeBase\*.json" />
    <EmbeddedResource Include="Resources\DmKnowledgeBase\*.csv" />
  </ItemGroup>

  <!-- Map each configuration to a Revit version and target framework -->
  <PropertyGroup Condition="$(Configuration.Contains('R24'))">
    <RevitVersion>2024</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R25'))">
    <RevitVersion>2025</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R26'))">
    <RevitVersion>2026</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R27'))">
    <RevitVersion>2027</RevitVersion>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <!-- Version-specific compile constant, e.g. REVIT2025, for API differences between versions -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Contains('Debug'))">
    <DebugType>full</DebugType>
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Official Revit API assemblies repackaged on NuGet (no local Revit install needed to build).
      The wildcard picks the latest package for the selected Revit version.
      If the package for a brand-new Revit version is not on NuGet yet, replace these with
      direct <Reference> items pointing at RevitAPI.dll / RevitAPIUI.dll in the Revit install folder.
    -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
    <!--
      Revit MCP module: JSON-RPC and configuration files. Revit ships Newtonsoft.Json 13 in its
      program folder, so it is compile-time only here (nothing is copied next to the add-in).
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- HttpClient for the update checker (implicit on the .NET 8/10 targets) -->
    <Reference Include="System.Net.Http" />
    <!-- ZipFile for the Revit MCP installer (implicit on the .NET 8/10 targets) -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!--
    Dev convenience: after a successful build on Windows, deploy the add-in straight into
    the current user's Revit Addins folder so you can just build and start Revit.
  -->
  <Target Name="DeployRevitAddin" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PropertyGroup>
      <AddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</AddinsDir>
    </PropertyGroup>
    <ItemGroup>
      <AddinAssembly Include="$(OutputPath)$(AssemblyName).dll" />
      <AddinAssembly Include="$(OutputPath)$(AssemblyName).pdb" Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(AddinAssembly)" DestinationFolder="$(AddinsDir)\CodeCompliance" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\install\CodeCompliance.addin" DestinationFolder="$(AddinsDir)" />
    <Message Importance="high" Text="Deployed CodeCompliance add-in to $(AddinsDir)" />
  </Target>

</Project>
